ENV=development
DATABASE_URL=sqlite:///./ppe_compliance.db

# Path to your trained PPE model (see backend/train/train_model.py).
# Leave as yolov8n.pt to run with stock COCO weights (person-detection only demo).
MODEL_PATH=yolov8n.pt
CONFIDENCE_THRESHOLD=0.45
IOU_THRESHOLD=0.45

VIOLATION_FRAME_THRESHOLD=5
VIOLATION_COOLDOWN_SECONDS=30

ALERTS_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-alert-bot@gmail.com
SMTP_PASSWORD=your-app-password
ALERT_EMAIL_TO=safety-officer@example.com
WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

CORS_ORIGINS=http://localhost:3000
